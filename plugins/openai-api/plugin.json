{
  "schemaVersion": 1,
  "id": "openai-api",
  "name": "OpenAI API",
  "version": "0.0.1",
  "entry": "plugin.js",
  "icon": "icon.svg",
  "brandColor": "#10A37F",
  "config": {
    "fields": [
      {
        "id": "apiKey",
        "type": "secret",
        "label": "Admin API Key",
        "placeholder": "sk-admin-...",
        "help": "留空则使用 OPENAI_ADMIN_KEY 或 OPENAI_API_KEY 环境变量",
        "defaultSource": true
      },
      {
        "id": "projectId",
        "type": "text",
        "label": "Project ID",
        "placeholder": "proj_...",
        "help": "可选。留空则使用 OPENAI_PROJECT_ID 环境变量",
        "defaultSource": true
      }
    ]
  },
  "lines": [
    { "type": "text", "label": "7D Spend", "scope": "overview" },
    { "type": "text", "label": "Requests", "scope": "overview" },
    { "type": "text", "label": "Tokens", "scope": "detail" },
    { "type": "progress", "label": "Credits", "scope": "overview", "primaryOrder": 1 }
  ]
}
