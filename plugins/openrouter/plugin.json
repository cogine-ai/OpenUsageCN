{
  "schemaVersion": 1,
  "id": "openrouter",
  "name": "OpenRouter",
  "version": "0.0.1",
  "entry": "plugin.js",
  "icon": "icon.svg",
  "brandColor": "#6467F2",
  "config": {
    "fields": [
      {
        "id": "apiKey",
        "type": "secret",
        "label": "API Key",
        "placeholder": "sk-or-v1-...",
        "help": "留空则使用 OPENROUTER_API_KEY 环境变量",
        "defaultSource": true
      },
      {
        "id": "apiUrl",
        "type": "text",
        "label": "API URL",
        "placeholder": "https://openrouter.ai/api/v1",
        "help": "可选。留空则使用 OPENROUTER_API_URL 或官方地址",
        "defaultSource": true
      }
    ]
  },
  "lines": [
    { "type": "progress", "label": "Credits", "scope": "overview", "primaryOrder": 1, "limitResource": { "key": "credits" } },
    { "type": "text", "label": "Balance", "scope": "overview" },
    { "type": "progress", "label": "Key Limit", "scope": "detail", "limitResource": { "key": "keyLimit" } },
    { "type": "text", "label": "Daily Spend", "scope": "detail" },
    { "type": "text", "label": "Weekly Spend", "scope": "detail" },
    { "type": "text", "label": "Monthly Spend", "scope": "detail" }
  ]
}
