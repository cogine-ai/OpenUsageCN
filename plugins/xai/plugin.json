{
  "schemaVersion": 1,
  "id": "xai",
  "name": "xAI",
  "version": "0.0.1",
  "entry": "plugin.js",
  "icon": "icon.svg",
  "brandColor": "#000000",
  "config": {
    "fields": [
      { "id": "managementKey", "type": "secret", "label": "Management API Key", "help": "留空则使用 XAI_MANAGEMENT_API_KEY 环境变量", "defaultSource": true },
      { "id": "teamId", "type": "text", "label": "Team ID", "help": "留空则使用 XAI_TEAM_ID 环境变量", "defaultSource": true }
    ]
  },
  "lines": [
    { "type": "text", "label": "Prepaid Balance", "scope": "overview" },
    { "type": "text", "label": "30D Spend", "scope": "overview" },
    { "type": "barChart", "label": "Daily Spend", "scope": "detail" }
  ]
}
