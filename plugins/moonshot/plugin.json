{
  "schemaVersion": 1,
  "id": "moonshot",
  "name": "Moonshot / Kimi Open Platform",
  "version": "0.0.1",
  "entry": "plugin.js",
  "icon": "icon.svg",
  "brandColor": "#007CFF",
  "config": {
    "fields": [
      {
        "id": "region",
        "type": "select",
        "label": "Region",
        "default": "auto",
        "options": [
          { "value": "auto", "label": "Auto (Environment Or International)" },
          { "value": "international", "label": "International" },
          { "value": "china", "label": "China Mainland" }
        ]
      },
      {
        "id": "apiKeyIntl",
        "type": "secret",
        "label": "International API Key",
        "placeholder": "sk-...",
        "help": "留空则使用 MOONSHOT_API_KEY；MOONSHOT_REGION 留空或为 international",
        "defaultSource": true
      },
      {
        "id": "apiKeyCn",
        "type": "secret",
        "label": "China Mainland API Key",
        "placeholder": "sk-...",
        "help": "留空则使用 MOONSHOT_API_KEY；需设置 MOONSHOT_REGION=china",
        "defaultSource": true
      }
    ]
  },
  "lines": [
    { "type": "text", "label": "Available Balance", "scope": "overview" },
    { "type": "text", "label": "Cash Balance", "scope": "detail" },
    { "type": "text", "label": "Voucher Balance", "scope": "detail" }
  ]
}
