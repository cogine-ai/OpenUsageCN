{
  "schemaVersion": 1,
  "id": "ollama",
  "name": "Ollama Cloud",
  "version": "0.0.1",
  "entry": "plugin.js",
  "icon": "icon.svg",
  "brandColor": "#000000",
  "links": [
    {
      "label": "Usage",
      "url": "https://ollama.com/settings"
    }
  ],
  "config": {
    "fields": [
      {
        "id": "source",
        "type": "select",
        "label": "Source",
        "default": "cookie",
        "options": [
          {
            "value": "cookie",
            "label": "Cookie"
          },
          {
            "value": "apiKey",
            "label": "API Key"
          }
        ]
      },
      {
        "id": "cookieHeader",
        "type": "secret",
        "label": "Cookie Header",
        "placeholder": "__Secure-session=...",
        "help": "Paste the Cookie header from ollama.com/settings. Leave blank to use OLLAMA_CLOUD_COOKIE.",
        "environmentVariables": [
          "OLLAMA_CLOUD_COOKIE"
        ],
        "defaultSource": true,
        "required": true,
        "visibleWhen": {
          "field": "source",
          "values": [
            "cookie"
          ]
        }
      },
      {
        "id": "apiKey",
        "type": "secret",
        "label": "API Key",
        "required": true,
        "placeholder": "Ollama API key",
        "help": "Create a key at ollama.com/settings/keys. Leave blank to use OLLAMA_API_KEY.",
        "environmentVariables": [
          "OLLAMA_API_KEY"
        ],
        "defaultSource": true,
        "visibleWhen": {
          "field": "source",
          "values": [
            "apiKey"
          ]
        }
      }
    ]
  },
  "lines": [
    {
      "type": "progress",
      "label": "Monthly",
      "scope": "overview",
      "primaryOrder": 1,
      "limitResource": {
        "key": "monthly"
      }
    },
    {
      "type": "progress",
      "label": "Session",
      "scope": "overview",
      "primaryOrder": 2,
      "limitResource": {
        "key": "session"
      }
    },
    {
      "type": "progress",
      "label": "Weekly",
      "scope": "overview",
      "period": "weekly",
      "limitResource": {
        "key": "weekly"
      }
    },
    {
      "type": "text",
      "label": "Purchased Credits",
      "scope": "detail"
    },
    {
      "type": "text",
      "label": "Account Details",
      "scope": "detail"
    }
  ],
  "supportingScripts": [
    "api.js",
    "reports.js"
  ]
}
