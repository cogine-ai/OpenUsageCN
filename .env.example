# Notarization
APPLE_ID=
APPLE_PASSWORD=
APPLE_TEAM_ID=

# GitHub Actions certificate import
APPLE_CERTIFICATE=
APPLE_CERTIFICATE_PASSWORD=
KEYCHAIN_PASSWORD=
